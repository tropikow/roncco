{
  "compilerOptions": {
    "allowJs": true,            
    "checkJs": true,
    "outDir": "dist",
    "rootDir": "./src",
    "sourceMap": true,
    "target": "ES6",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strict": true,   
    "ignoreDeprecations": "6.0",
    "baseUrl": ".", 
    "paths": {
      "@config/*": ["src/config/index"],
      "@helpers/*": ["src/helpers/index"],
      "@router/*": ["src/routes/router"]
    }
  },
  "include": ["src/**/*"]
}